# =====================================================================
# Application & Client Runtime Configuration (.env.local)
# =====================================================================

# Aggregator Express Server listening port
SERVER_PORT=25133

# Public API URL for frontend (keep as relative /api/status when served by Express)
VITE_API_URL=/api/status

# Frontend debug mode (set to true to render raw public JSON on dashboard)
VITE_SHOW_DEBUG=false

# Optional fallback bot endpoints (used only when bots.config.json is absent)
# BOT_ENDPOINTS=NekoBot|http://127.0.0.1:25016/api/uptime/status
