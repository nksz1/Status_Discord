# =====================================================================
# Server Environment Configuration (.env)
# Do NOT commit the real .env file with production tokens to Git!
# =====================================================================

# Server-side Bearer tokens for each monitored bot (minimum 32 characters, recommended 64-hex)
# These environment variable names must match the "tokenEnv" in bots.config.json
UPTIME_TOKEN_NEKOBOT=your_secure_random_64_hex_token_for_nekobot_here
UPTIME_TOKEN_NEKOBOT_GLOBAL=your_secure_random_64_hex_token_for_nekobot_global_here
UPTIME_TOKEN_NEKO_NIGHTFALL=your_secure_random_64_hex_token_for_neko_nightfall_here
UPTIME_TOKEN_AUTO_QUEST=your_secure_random_64_hex_token_for_auto_quest_here

# Public Status API Rate Limiting (in-memory IP rate limiter)
PUBLIC_STATUS_RATE_LIMIT_MAX=60
PUBLIC_STATUS_RATE_LIMIT_WINDOW_MS=60000

# Optional CORS origin restriction (leave blank to omit CORS headers)
PUBLIC_CORS_ORIGIN=

# Trusted reverse proxy hops count:
# - Set to 0 (default) if Express is directly exposed to clients.
# - Set to 1 if behind 1 reverse proxy (e.g. Cloudflare, Nginx, Caddy, Docker bridge).
# IMPORTANT: If behind a reverse proxy, set this to 1 so individual client IPs are rate-limited rather than the proxy IP.
TRUST_PROXY_HOPS=0

